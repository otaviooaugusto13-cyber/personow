{
  "rules": {
    ".read": false,
    ".write": false,
    "presenca": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'ultimaVez']) && newData.child('online').isBoolean()"
      }
    }
  }
}
