rules_version = '2';
// ============================================================
// PERSONOW — Regras do Firestore (DENY BY DEFAULT)
//
// Princípio: o navegador LÊ o que é dele e quase não escreve. Dinheiro, status de aula, treinamento, idade,
// papéis, notas e dados sensíveis são escritos SOMENTE pelo servidor (Admin SDK ignora estas regras).
// O papel (role) e o treinamento concluído (treinado) vêm de custom claims assinadas — o usuário não consegue forjá-las.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function logado() { return request.auth != null; }
    function papel() { return logado() ? request.auth.token.get('role', '') : ''; }
    function ehAluno() { return papel() == 'aluno'; }
    function ehPersonal() { return papel() == 'personal'; }
    function ehAdmin() { return papel() == 'admin'; }
    function treinado() { return request.auth.token.get('treinado', false) == true; }
    function banido() { return logado() && request.auth.token.get('banido', false) == true; }   // claim definida pelo servidor na 3ª advertência
    function dono(uid) { return logado() && request.auth.uid == uid; }
    // só estes campos podem mudar numa atualização feita pelo cliente
    function soMuda(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    // campo opcional: ausente OU string de até n caracteres
    function str(campo, n) { return !(campo in request.resource.data) || (request.resource.data[campo] is string && request.resource.data[campo].size() <= n); }

    // ---------- negado por padrão ----------
    match /{documento=**} { allow read, write: if false; }

    // ---------- identidade ----------
    match /usuarios/{uid} {
      allow read: if dono(uid) || ehAdmin();
      allow write: if false;
    }

    // ---------- aluno ----------
    match /alunos/{uid} {
      allow read: if dono(uid) || ehAdmin();
      allow create, delete: if false;                           // criado por POST /cadastro/aluno
      allow update: if dono(uid) && ehAluno()
        && soMuda(['nomeCompleto', 'documento', 'endereco', 'email', 'telefone', 'objetivo', 'prefs', 'nome', 'atualizadoEm'])
        && str('nomeCompleto', 160) && str('documento', 20) && str('endereco', 200) && str('email', 120) && str('telefone', 20) && str('objetivo', 60) && str('nome', 100)
        && (!('prefs' in request.resource.data) || request.resource.data.prefs is map);
    }
    match /cartoes/{uid} {                                      // só exibição (bandeira, final, validade); IDs do gateway ficam em cartoes_privado
      allow read: if dono(uid);
      allow write: if false;
    }

    // ---------- personal ----------
    match /personais/{uid} {
      // o próprio, equipe, e alunos só veem perfis APROVADOS (para "chamar" um personal)
      allow read: if dono(uid) || ehAdmin() || (ehAluno() && resource.data.status == 'ativo');
      allow create, delete: if false;                           // criado por POST /cadastro/personal
      // status, treinamentoOk, rating, refCode, etc. NÃO estão na lista: o cliente não consegue se auto-aprovar nem se "formar"
      allow update: if dono(uid) && ehPersonal()
        && soMuda(['bio', 'cidade', 'especialidade', 'disponibilidade', 'valorMin', 'nome'])
        && (!('nome' in request.resource.data.diff(resource.data).affectedKeys()) || resource.data.status == 'pendente')
        && str('bio', 300) && str('cidade', 80) && str('especialidade', 60) && str('nome', 100)
        && (!('valorMin' in request.resource.data) || (request.resource.data.valorMin is int && request.resource.data.valorMin >= 0 && request.resource.data.valorMin <= 100000))
        && (!('disponibilidade' in request.resource.data) || (request.resource.data.disponibilidade is map
              && request.resource.data.disponibilidade.keys().hasOnly(['inicio', 'fim'])));
    }
    match /personais_privado/{uid} { allow read, write: if false; }      // CPF, nascimento, telefone, Pix: cifrados, só servidor
    match /cartoes_privado/{uid}       { allow read, write: if false; }

    // ---------- treinamento (tudo via API: a ordem dos módulos e o progresso são validados no servidor) ----------
    match /treinamento_modulos/{id}    { allow read, write: if false; }
    match /treinamento_progresso/{id}  { allow read, write: if false; }
    // habilitação por categoria: conteúdo (com GABARITO) e sessões só no servidor; o selo vive em personais/{uid}.habilitacoes (cliente NÃO escreve)
    match /habilitacao_categorias/{id} { allow read, write: if false; }
    match /habilitacao_sessoes/{id}    { allow read, write: if false; }

    // ---------- suporte (chat equipe ↔ usuário): o navegador só LÊ; escrever é só pela API ----------
    match /suporte_conversas/{uid} { allow read: if dono(uid) || ehAdmin(); allow write: if false; }
    match /suporte_mensagens/{id}  { allow read: if logado() && (resource.data.uid == request.auth.uid || ehAdmin()); allow write: if false; }
    // push_tokens: nenhuma regra → negado por padrão (só o servidor lê/escreve)

    // ---------- aulas ----------
    match /aulas/{id} {
      allow read: if logado() && (
        resource.data.uid == request.auth.uid                                           // aluno dona
        || resource.data.get('personalUid', '') == request.auth.uid                     // personal escalado
        || ehAdmin()
        // ofertas abertas: só para personal aprovado-e-TREINADO (claim) — defesa em profundidade além do bloqueio no servidor
        || (ehPersonal() && treinado() && !banido() && resource.data.status == 'aberta'));
      allow write: if false;                                                            // criar/aceitar/cancelar/desistir/avaliar: só pelo servidor

      match /mensagens/{mid} {
        function aula() { return get(/databases/$(database)/documents/aulas/$(id)).data; }
        function participante() { return logado() && (request.auth.uid == aula().uid || request.auth.uid == aula().get('personalUid', '')); }
        allow read: if participante();
        allow create: if participante()
          && request.resource.data.keys().hasOnly(['de', 'texto', 'criadoEm'])
          && request.resource.data.de == request.auth.uid
          && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 500
          && request.resource.data.criadoEm == request.time
          && aula().status in ['aberta', 'aceita', 'paga'];
        allow update, delete: if false;
      }
    }
    match /aulas_financeiro/{id} { allow read: if logado() && resource.data.uid == request.auth.uid; allow write: if false; }
    match /notas/{id}                   { allow read: if logado() && (resource.data.alunoUid == request.auth.uid || ehAdmin()); allow write: if false; }

    // ---------- dinheiro: nada pelo cliente (o app usa GET /carteira) ----------
    match /pagamentos_internos/{id} { allow read, write: if false; }
    match /carteiras/{id}           { allow read, write: if false; }
    match /lancamentos/{id}         { allow read, write: if false; }
    match /saques/{id}              { allow read, write: if false; }
    match /estornos/{id}            { allow read, write: if false; }
    match /contadores/{id}          { allow read, write: if false; }
    match /auditoria/{id}           { allow read, write: if false; }

    // ---------- módulo de TI: TUDO só pelo servidor (a tela de TI usa a API; Admin SDK ignora estas regras) ----------
    // Negar de forma explícita documenta a intenção e protege contra um "allow" genérico futuro. A trilha é append-only e encadeada por hash.
    match /ti_operadores/{id}            { allow read, write: if false; }
    match /ti_auditoria/{id}             { allow read, write: if false; }
    match /ti_auditoria_cadeia/{id}      { allow read, write: if false; }
    match /chamados_ti/{id}              { allow read, write: if false; match /eventos/{ev} { allow read, write: if false; } }
    match /ti_metricas_dia/{id}          { allow read, write: if false; }
    match /ti_produtividade/{id}         { allow read, write: if false; }
    match /presenca_instancias/{id}      { allow read, write: if false; }
    // ---------- reputação: níveis, vidas, infrações (o dono LÊ; só o servidor escreve) ----------
    match /reputacao/{uid}          { allow read: if dono(uid) || ehAdmin(); allow write: if false; }
    match /infracoes/{id}           { allow read: if logado() && (resource.data.uid == request.auth.uid || ehAdmin()); allow write: if false; }
    match /niveis_historico/{id}    { allow read, write: if false; }

    // ---------- execução da aula: foto do local da aula, presença por GPS, alertas, parceiros (tudo só pela API) ----------
    match /fotos_checkout/{id}      { allow read, write: if false; }
    match /presencas/{id}           { allow read, write: if false; }
    match /alertas_personal/{id}    { allow read, write: if false; }
    match /parceiros/{id}              { allow read, write: if false; }

    // ---------- mapa de personais online (aluno) ----------
    // A posição do personal NUNCA passa pelo Firestore do cliente: chega no ping de presença, é arredondada (~300 m) no servidor e só sai por GET /personais/online.
    // `personais/{uid}` não tem campo de posição e o cliente não pode criá-lo (soMuda acima); `presenca_instancias` e `alertas_personal` são só do servidor.

    // ---------- deny-by-default: qualquer coleção não listada acima é negada ----------
    match /{document=**} { allow read, write: if false; }
  }
}
